{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "岁岁时光",
  "version": "0.1.0",
  "identifier": "fun.upup.suitime",
  "build": {
    "beforeDevCommand": "cd ../desktop-client && npm run dev",
    "devUrl": "http://127.0.0.1:5180",
    "beforeBuildCommand": "cd ../desktop-client && npm run build",
    "frontendDist": "../../desktop-client/dist"
  },
  "app": {
    "windows": [
      {
        "title": "岁岁时光",
        "width": 1360,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
